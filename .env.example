# ==========================================
# ExeSistemasWEB - Variables de Entorno (Next.js)
# ==========================================

# ------------------------------------------
# 1. Variables Públicas (Cliente & Navegador)
# ------------------------------------------
# URL de la base de datos Supabase
NEXT_PUBLIC_SUPABASE_URL=https://bksonxnxshxinqffswqc.supabase.co
# Llave pública anónima de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
# URL del sitio para redirects y canónicas
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Client ID de PayPal para botones de pago
NEXT_PUBLIC_PAYPAL_CLIENT_ID=tu_paypal_client_id
# Sentry DSN para monitoreo de errores en cliente
NEXT_PUBLIC_SENTRY_DSN=
# UI Variant para Dashboard
NEXT_PUBLIC_DASHBOARD_UI=v2
# Activar solo cuando el despliegue corre detrás de Vercel
NEXT_PUBLIC_ENABLE_VERCEL_TELEMETRY=false

# ------------------------------------------
# 2. Secretos del Servidor (NUNCA EXPUESTOS AL CLIENTE)
# ------------------------------------------
# Llave de rol de servicio Supabase (Bypass RLS para webhooks y tareas de sistema)
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key

# Resend API Key para envío de correos transaccionales
RESEND_API_KEY=re_tu_resend_api_key
# Secreto de firma de webhook de Resend (Svix)
RESEND_WEBHOOK_SIGNING_SECRET=whsec_tu_svix_secret

# PayPal Backend Secrets
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret
PAYPAL_WEBHOOK_ID=tu_paypal_webhook_id
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Motores de Inteligencia Artificial (Chatbot)
GEMINI_API_KEY=tu_gemini_api_key
GROQ_API_KEY=tu_groq_api_key

# Destinatario de alertas y auditoría
ADMIN_EMAIL=Exemetal@hotmail.com
SITE_URL=http://localhost:3000
